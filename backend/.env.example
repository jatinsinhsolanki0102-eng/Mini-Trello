# --- Mini-Trello Backend environment variables ---
# Copy this file to ".env" and adjust values for your machine.
# Never commit the real ".env" file with passwords.

# Database connection string.
# SQLite (used by default for zero-setup local development):
DATABASE_URL=sqlite:///mini_trello.db

# MySQL (recommended for the project as per requirements).
# Uncomment and adapt to use MySQL instead of SQLite:
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/mini_trello

# Port the Flask server listens on.
PORT=5000

# Allowed browser origins for CORS (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174